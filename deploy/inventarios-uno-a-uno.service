[Unit]
Description=Inventarios Uno a Uno (Flask / Gunicorn)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=inventarios
Group=inventarios
WorkingDirectory=/opt/apps/inventarios-uno-a-uno
EnvironmentFile=/etc/inventarios-uno-a-uno/inventarios.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# /var/lock -> /run/lock on Debian; RuntimeDirectory recreates it after reboot.
RuntimeDirectory=lock/inventarios-uno-a-uno
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# One process is mandatory for the in-memory SSO replay cache.
# Log path only (%U), never query string, body, Cookie or Authorization.
ExecStart=/opt/apps/inventarios-uno-a-uno/.venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 1 --threads 4 --timeout 300 --graceful-timeout 300 --access-logfile - --access-logformat "%%(h)s %%(t)s %%(m)s %%(U)s %%(s)s %%(L)s" --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=330
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
